{"lesson":6,"items":[{"id":"minna-006-g1","pattern":"N を 〜ます","lessonTitle":{"en":"Actions & Invitations","bn":"কাজ ও আমন্ত্রণ"},"meaning_en":"do ~ (with object N)","meaning_bn":"N খাই / N করি (কর্ম)","examples":[{"jp":"ご飯を 食べます。","romaji":"gohan o tabemasu.","en":"I eat a meal.","bn":"আমি ভাত খাই।"}]},{"id":"minna-006-g2","pattern":"〜ませんか","lessonTitle":{"en":"Actions & Invitations","bn":"কাজ ও আমন্ত্রণ"},"meaning_en":"won't you ~? (invitation)","meaning_bn":"~ করবেন না? (আমন্ত্রণ)","examples":[{"jp":"一緒に 行きませんか。","romaji":"issho ni ikimasen ka.","en":"Won't you go together?","bn":"একসাথে যাবেন না?"}]},{"id":"minna-006-g3","pattern":"〜ましょう","lessonTitle":{"en":"Actions & Invitations","bn":"কাজ ও আমন্ত্রণ"},"meaning_en":"let's ~","meaning_bn":"চলুন ~ করি","examples":[{"jp":"一緒に 行きましょう。","romaji":"issho ni ikimashou.","en":"Let's go together.","bn":"চলুন একসাথে যাই।"}]},{"id":"minna-006-g4","pattern":"N が 好きです / 嫌いです","lessonTitle":{"en":"Actions & Invitations","bn":"কাজ ও আমন্ত্রণ"},"meaning_en":"like / dislike N","meaning_bn":"N পছন্দ / অপছন্দ","examples":[{"jp":"寿司が 好きです。","romaji":"sushi ga suki desu.","en":"I like sushi.","bn":"আমি সুশি পছন্দ করি।"}]}]}
