{"lesson":4,"items":[{"id":"minna-004-g1","pattern":"〜時 / 〜分","lessonTitle":{"en":"Time & Daily Routine","bn":"সময় ও দৈনন্দিন কাজ"},"meaning_en":"hour / minute","meaning_bn":"~টা / ~মিনিট (সময়)","examples":[{"jp":"今、4時です。","romaji":"ima, yoji desu.","en":"It is 4 o'clock now.","bn":"এখন চারটা বাজে।"}]},{"id":"minna-004-g2","pattern":"〜から 〜まで","lessonTitle":{"en":"Time & Daily Routine","bn":"সময় ও দৈনন্দিন কাজ"},"meaning_en":"from ~ to ~","meaning_bn":"~ থেকে ~ পর্যন্ত","examples":[{"jp":"9時から 5時まで 働きます。","romaji":"kuji kara goji made hatarakimasu.","en":"I work from 9 to 5.","bn":"আমি নটা থেকে পাঁচটা পর্যন্ত কাজ করি।"}]},{"id":"minna-004-g3","pattern":"〜ます / 〜ません","lessonTitle":{"en":"Time & Daily Routine","bn":"সময় ও দৈনন্দিন কাজ"},"meaning_en":"polite present aff. / neg.","meaning_bn":"ভদ্র বর্তমান কাল (হ্যাঁ-বোধক / না-বোধক)","examples":[{"jp":"毎日 勉強します。","romaji":"mainichi benkyou shimasu.","en":"I study every day.","bn":"আমি প্রতিদিন পড়াশোনা করি।"}]},{"id":"minna-004-g4","pattern":"〜ました / 〜ませんでした","lessonTitle":{"en":"Time & Daily Routine","bn":"সময় ও দৈনন্দিন কাজ"},"meaning_en":"polite past aff. / neg.","meaning_bn":"ভদ্র অতীত কাল (হ্যাঁ-বোধক / না-বোধক)","examples":[{"jp":"昨日 勉強しました。","romaji":"kinou benkyou shimashita.","en":"I studied yesterday.","bn":"আমি গতকাল পড়াশোনা করেছিলাম।"}]}]}
