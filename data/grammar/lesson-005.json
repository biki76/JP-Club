{"lesson":5,"items":[{"id":"minna-005-g1","pattern":"N へ 行きます","lessonTitle":{"en":"Going, Coming & Dates","bn":"যাওয়া, আসা ও তারিখ"},"meaning_en":"go to N","meaning_bn":"N-এ যাই","examples":[{"jp":"日本へ 行きます。","romaji":"nihon e ikimasu.","en":"I will go to Japan.","bn":"আমি জাপানে যাব।"}]},{"id":"minna-005-g2","pattern":"N で 行きます","lessonTitle":{"en":"Going, Coming & Dates","bn":"যাওয়া, আসা ও তারিখ"},"meaning_en":"go by N","meaning_bn":"N দিয়ে (যানবাহনে) যাই","examples":[{"jp":"電車で 行きます。","romaji":"densha de ikimasu.","en":"I will go by train.","bn":"আমি ট্রেনে যাব।"}]},{"id":"minna-005-g3","pattern":"N と 行きます","lessonTitle":{"en":"Going, Coming & Dates","bn":"যাওয়া, আসা ও তারিখ"},"meaning_en":"go with N","meaning_bn":"N-এর সাথে যাই","examples":[{"jp":"友達と 行きます。","romaji":"tomodachi to ikimasu.","en":"I will go with a friend.","bn":"আমি বন্ধুর সাথে যাব।"}]},{"id":"minna-005-g4","pattern":"いつ","lessonTitle":{"en":"Going, Coming & Dates","bn":"যাওয়া, আসা ও তারিখ"},"meaning_en":"when","meaning_bn":"কখন","examples":[{"jp":"いつ 日本へ 行きますか。","romaji":"itsu nihon e ikimasu ka.","en":"When will you go to Japan?","bn":"তুমি কখন জাপানে যাবে?"}]}]}
