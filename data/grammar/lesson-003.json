{"lesson":3,"items":[{"id":"minna-003-g1","pattern":"ここ / そこ / あそこ","lessonTitle":{"en":"Places & Shopping","bn":"স্থান ও কেনাকাটা"},"meaning_en":"here / there / over there","meaning_bn":"এখানে / সেখানে / ওখানে","examples":[{"jp":"ここは 教室です。","romaji":"koko wa kyoushitsu desu.","en":"Here is a classroom.","bn":"এখানে ক্লাসরুম।"}]},{"id":"minna-003-g2","pattern":"N は どこですか","lessonTitle":{"en":"Places & Shopping","bn":"স্থান ও কেনাকাটা"},"meaning_en":"Where is N?","meaning_bn":"N কোথায়?","examples":[{"jp":"トイレは どこですか。","romaji":"toire wa doko desu ka.","en":"Where is the toilet?","bn":"টয়লেট কোথায়?"}]},{"id":"minna-003-g3","pattern":"N を ください","lessonTitle":{"en":"Places & Shopping","bn":"স্থান ও কেনাকাটা"},"meaning_en":"Please give me N","meaning_bn":"N দিন (দয়া করে)","examples":[{"jp":"これを ください。","romaji":"kore o kudasai.","en":"Please give me this.","bn":"এটা আমাকে দিন।"}]},{"id":"minna-003-g4","pattern":"N を お願いします","lessonTitle":{"en":"Places & Shopping","bn":"স্থান ও কেনাকাটা"},"meaning_en":"N, please","meaning_bn":"N, দয়া করে দিন","examples":[{"jp":"コーヒーを お願いします。","romaji":"koohii o onegaishimasu.","en":"Coffee, please.","bn":"কফি দয়া করে দিন।"}]}]}
