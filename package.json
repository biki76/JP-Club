{
  "name": "jp-club",
  "version": "1.0.0",
  "description": "JP-Club is an online Japanese-learning platform organized around the Minna no Nihongo textbook series. The English version provides a structured curriculum of 50 lessons, with Japanese lesson titles and English explanations of their learning objectives. It is intended for learners, teachers, and people studying Japanese independently.",
  "scripts": {
    "test": "node tests/run-ts.mjs && node --test tests/stream.test.mjs tests/sanitize.test.mjs",
    "gen:config": "node --env-file=.env scripts/gen-config.mjs",
    "build:data": "node tools/build-data.mjs",
    "check:data": "node tools/build-data.mjs --check && node tools/validate-data.mjs",
    "harden": "node tools/apply-hardening.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biki76/JP-Club.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/biki76/JP-Club/issues"
  },
  "homepage": "https://github.com/biki76/JP-Club#readme",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "js-yaml": "^5.5.0",
    "kanji": "^0.19.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5"
  }
}
